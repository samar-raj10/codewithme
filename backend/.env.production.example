# Production Server Port (Assigned automatically by cloud platforms like Render/Heroku)
PORT=5050
NODE_ENV=production

# MongoDB Production Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/leetrevise?retryWrites=true&w=majority

# Supabase Authentication Credentials
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Allowed CORS Origins (Comma-separated list for separate frontend hosting e.g., Vercel/Netlify)
ALLOWED_ORIGINS=https://leetrevise.vercel.app,https://leetrevise.netlify.app
